FAMILYGUARD_DB_URL=jdbc:mysql://localhost:3306/familyguard_db
FAMILYGUARD_DB_USERNAME=familyguard_app
FAMILYGUARD_DB_PASSWORD=CAMBIAR_EN_EL_ENTORNO
# Clave AES del PIN parental (Base64 de 32 bytes aleatorios). Generarla en el equipo del servidor, por ejemplo:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
FAMILYGUARD_PIN_KEY=GENERAR_EN_EL_ENTORNO
