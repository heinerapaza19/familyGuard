# Plantilla de variables del backend (Etapa 7). Copiar a /etc/familyguard/backend.env con permisos 600.
# Genere las contraseñas en el servidor; nunca las guarde en el repositorio ni en los instaladores.
FAMILYGUARD_DB_URL=jdbc:mysql://127.0.0.1:3306/familyguard_db
FAMILYGUARD_DB_USERNAME=familyguard_app
FAMILYGUARD_DB_PASSWORD=CAMBIAR_EN_EL_SERVIDOR
# Usuario separado para migraciones Flyway (opcional; si se omite se usa el de la aplicación).
FAMILYGUARD_FLYWAY_USERNAME=familyguard_migracion
FAMILYGUARD_FLYWAY_PASSWORD=CAMBIAR_EN_EL_SERVIDOR
FAMILYGUARD_BIND_ADDRESS=127.0.0.1
FAMILYGUARD_SERVER_PORT=8080
# Clave AES del PIN parental (Base64 de 32 bytes). Generarla en el servidor: openssl rand -base64 32
# Si se pierde, los PIN guardados no podrán mostrarse con «Ver PIN» (habrá que configurar uno nuevo).
FAMILYGUARD_PIN_KEY=GENERAR_EN_EL_SERVIDOR
