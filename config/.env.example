# Desarrollo local: copie estas variables al entorno del proceso. No guarde secretos reales en Git.
FAMILYGUARD_DB_URL=jdbc:mysql://localhost:3306/familyguard_db?serverTimezone=UTC
FAMILYGUARD_DB_USERNAME=familyguard_app
FAMILYGUARD_DB_PASSWORD=replace_with_a_secure_secret

# Despliegue remoto: active el perfil y deje el backend accesible solo al proxy HTTPS local.
SPRING_PROFILES_ACTIVE=remote
FAMILYGUARD_BIND_ADDRESS=127.0.0.1
FAMILYGUARD_SERVER_PORT=8080
FAMILYGUARD_DB_POOL_SIZE=10
