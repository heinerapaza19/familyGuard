<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Panel principal del Agente: barra lateral azul (280 px), contenido, selector de tema y barra de estado (52 px). -->
<BorderPane fx:id="shell" styleClass="agent-shell" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.familyguard.agent.AgentShellController">
    <left>
        <VBox spacing="10" styleClass="sidebar">
            <padding><Insets top="26" right="18" bottom="18" left="18"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="sidebar-brand">
                <StackPane styleClass="brand-shield">
                    <Group scaleX="1.45" scaleY="1.45">
                        <SVGPath content="M12 2 L20 5 V11 C20 16.5 16.6 20.6 12 22 C7.4 20.6 4 16.5 4 11 V5 Z" styleClass="brand-shield-body"/>
                        <SVGPath content="M12 5.2 L17.4 7.2 V11.2 C17.4 15 15.2 17.9 12 19 Z" styleClass="brand-shield-detail"/>
                        <SVGPath content="M8.2 12.2 L11 15 L16.2 9.4" styleClass="brand-shield-check"/>
                    </Group>
                </StackPane>
                <VBox spacing="1">
                    <Label text="FamilyGuard" styleClass="brand-title"/>
                    <Label text="Agente Windows" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <Region minHeight="14" prefHeight="14"/>
            <Button fx:id="homeButton" text="Inicio" onAction="#openHome" maxWidth="Infinity" styleClass="nav-button">
                <graphic><SVGPath content="M3.5 11 L12 3.5 L20.5 11 M5.5 9.5 V20.5 H10 V14.5 H14 V20.5 H18.5 V9.5" styleClass="nav-icon"/></graphic>
            </Button>
            <Button fx:id="activityButton" text="Actividad" onAction="#openActivity" maxWidth="Infinity" styleClass="nav-button">
                <graphic><SVGPath content="M3 12h4l3-7 4 14 3-7h4" styleClass="nav-icon"/></graphic>
            </Button>
            <Button fx:id="connectionButton" text="Conexión" onAction="#openConnection" maxWidth="Infinity" styleClass="nav-button">
                <graphic><SVGPath content="M2.5 9a14 14 0 0 1 19 0 M5.5 12.5a9.5 9.5 0 0 1 13 0 M8.7 16a5 5 0 0 1 6.6 0 M12 19.6v.1" styleClass="nav-icon"/></graphic>
            </Button>
            <Button fx:id="settingsButton" text="Ajustes" onAction="#openSettings" maxWidth="Infinity" styleClass="nav-button">
                <graphic><SVGPath content="M4 6h9 M17 6h3 M15 4v4 M4 12h3 M11 12h9 M9 10v4 M4 18h11 M19 18h1 M17 16v4" styleClass="nav-icon"/></graphic>
            </Button>
            <Button fx:id="privacyButton" text="Privacidad" onAction="#openPrivacy" maxWidth="Infinity" styleClass="nav-button">
                <graphic><SVGPath content="M5.5 10.5h13v10h-13z M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3 M12 14.5v2.5" styleClass="nav-icon"/></graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
            <StackPane fx:id="sidebarArt" styleClass="sidebar-art"/>
        </VBox>
    </left>
    <center>
        <VBox styleClass="main-area">
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitle" text="Mi dispositivo" styleClass="page-title"/>
                    <Label fx:id="pageSubtitle" text="Resumen de la supervisión y estado de este equipo" styleClass="page-subtitle"/>
                </VBox>
                <HBox alignment="CENTER" spacing="4" styleClass="theme-toggle">
                    <Button fx:id="lightButton" text="Claro" onAction="#chooseLight" styleClass="theme-option">
                        <graphic><SVGPath content="M12 7.5a4.5 4.5 0 1 0 .01 0z M12 2v2 M12 20v2 M4.9 4.9l1.4 1.4 M17.7 17.7l1.4 1.4 M2 12h2 M20 12h2 M4.9 19.1l1.4-1.4 M17.7 6.3l1.4-1.4" styleClass="theme-icon"/></graphic>
                    </Button>
                    <Button fx:id="darkButton" text="Oscuro" onAction="#chooseDark" styleClass="theme-option">
                        <graphic><SVGPath content="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5z" styleClass="theme-icon"/></graphic>
                    </Button>
                </HBox>
            </HBox>
            <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                <content><StackPane fx:id="contentHost" styleClass="content-host"/></content>
            </ScrollPane>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="26" styleClass="status-bar">
            <padding><Insets top="0" right="28" bottom="0" left="28"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <SVGPath content="M4 5h16v10H4z M2 19h20" styleClass="footer-icon"/>
                <Label fx:id="footerDevice" text="—" styleClass="footer-text"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <SVGPath content="M4 4h16v6.5H4z M4 13.5h16V20H4z M8 7.2h.1 M8 16.7h.1" styleClass="footer-icon"/>
                <Label fx:id="footerServer" text="—" styleClass="footer-text"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="7">
                <Region fx:id="footerDot" styleClass="footer-dot"/>
                <Label fx:id="footerConnection" text="Conectando…" styleClass="footer-connection"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="footerVersion" text="" styleClass="footer-text"/>
        </HBox>
    </bottom>
</BorderPane>
